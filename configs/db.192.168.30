;
; BIND Reverse Zone: 30.168.192.in-addr.arpa
;
$TTL    604800
@       IN      SOA     ns1.asiannet.internal. admin.asiannet.internal. (
                              2026110401 ; Serial
                                  604800 ; Refresh
                                   86400 ; Retry
                                 2419200 ; Expire
                                  604800 ) ; Negative Cache TTL
;
@       IN      NS      ns1.asiannet.internal.
@       IN      NS      ns2.asiannet.internal.

; PTR Records
1       IN      PTR     gateway.asiannet.internal.
10      IN      PTR     ns1.asiannet.internal.
12      IN      PTR     ns2.asiannet.internal.
15      IN      PTR     radius.asiannet.internal.
20      IN      PTR     olt-master.asiannet.internal.
25      IN      PTR     mail.asiannet.internal.
50      IN      PTR     noc-monitor.asiannet.internal.

